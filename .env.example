RSS_URL=https://forums.kleientertainment.com/rss/6-dont-starve-together-updates.xml/
UPDATE_PAGE_URL=https://forums.kleientertainment.com/game-updates/dst/

REDIS_URL=redis://127.0.0.1:6379
REDIS_CHANNEL=dst-updates
REDIS_DEDUPE_KEY=dst:last_build
# Phase 5：canonical（push.v1 proto）发布 Stream 与失败升级阈值
REDIS_MSGS_STREAM=stream:msgs:in
FAILURE_ESCALATE_COUNT=5
FAILURE_ESCALATE_HOURS=24

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
# 请求超时与重试：模型网关偶发挂死，超时后按指数退避重试（只重试超时/429/5xx）
LLM_REQUEST_TIMEOUT_SECS=180
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_MS=3000

PO_ZIP_PATH=/path/to/scripts.zip
PO_ZIP_PO_FILES=scripts/languages/chinese_s.po,scripts/languages/chinese_t.po